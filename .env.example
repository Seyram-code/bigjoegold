DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/bigjoegold"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://127.0.0.1:3000"
STAFF_ACCESS_CODE_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"

# Required once for the initial owner account.
ADMIN_NAME="Big Joe Gold Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PHONE="+233XXXXXXXXX"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Optional owner-only operational SMS notifications via Wigal FROG.
# Keep these values private; the sender ID must be approved in your FROG account.
WIGAL_FROG_API_KEY="replace-with-your-wigal-api-key"
WIGAL_FROG_USERNAME="replace-with-your-wigal-username"
WIGAL_FROG_SENDER_ID="replace-with-your-approved-sender-id"
WIGAL_FROG_OWNER_PHONE="+233XXXXXXXXX"
